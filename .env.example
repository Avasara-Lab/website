# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# One inbox that receives enquiries. Visitors cannot choose this address.
CONTACT_TO_EMAIL=

# Verified sender on a domain you verified in Resend.
# Example: Avasara Lab <enquiries@yourdomain.com>
# Do not use an unverified placeholder such as hello@avasaralab.com.
CONTACT_FROM_EMAIL=

# Public site origin, including https, for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://avasaralab.com
