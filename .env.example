# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# One inbox that receives enquiries. Visitors cannot choose this address.
CONTACT_TO_EMAIL=

# Verified sender on a domain you verified in Resend.
# Example: Avasara Lab <enquiries@yourdomain.com>
# Do not use an unverified placeholder such as hello@avasaralab.com.
CONTACT_FROM_EMAIL=

# Public site origin for canonical URLs, metadata, and the sitemap.
# Use an absolute URL with https. The canonical origin is https://avasaralab.com.
# A bare hostname is given https://. www.avasaralab.com is normalized to the apex origin.
# Any other malformed value fails the build instead of being ignored.
NEXT_PUBLIC_SITE_URL=https://avasaralab.com

# Opportunity Intelligence application.
# PostgreSQL connection string. /app and /api/auth fail without it.
# /login and /register still render; submitting them calls /api/auth.
# Hostinger Web and Cloud hosting create MySQL and may write mysql:// into this name.
# Do not use that URL. Point this at external PostgreSQL, or PostgreSQL you run on a VPS.
# Include the provider's TLS parameters when required, for example sslmode=require.
DATABASE_URL=postgres://avasara:avasara@127.0.0.1:5432/avasara

# At least 16 characters or auth refuses to start. Use at least 32 random characters in production.
# Never commit a real value.
BETTER_AUTH_SECRET=

# Absolute origin of this deployment, with no path. Auth cookies and trusted origins use it.
# It must match the origin the browser opens. Locally this is http://localhost:3000.
# On a temporary host, use that host. After the custom domain is connected, use https://avasaralab.com.
# It is not the public marketing canonical URL when those origins differ.
BETTER_AUTH_URL=http://localhost:3000

# Meta Model API key from the Model API dashboard. Server only.
# When empty, live model calls are blocked and no other provider is used.
MODEL_API_KEY=

# Optional override. Leave unset to use https://api.meta.ai/v1.
# META_API_BASE_URL=https://api.meta.ai/v1

# Inline ingestion is the default. Set queue and run `npm run worker` to use BullMQ.
# INGESTION_MODE=queue
# REDIS_URL=redis://127.0.0.1:6379

# Cloudflare R2 (S3-compatible). When any of these are missing, files are stored in .data/uploads.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
