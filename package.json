{
  "name": "avasara-lab-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --import ./scripts/register-test-hooks.mjs --test $(find src/lib src/server -name '*.test.ts' | sort)",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local --experimental-strip-types --import ./scripts/register-test-hooks.mjs scripts/migrate.ts",
    "db:seed": "node --env-file=.env.local --experimental-strip-types --import ./scripts/register-test-hooks.mjs scripts/seed-demo.ts",
    "worker": "node --env-file=.env.local --experimental-strip-types --import ./scripts/register-test-hooks.mjs src/server/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "better-auth": "^1.7.14",
    "bullmq": "^6.5.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
